# The @gavmor scope resolves from GitHub Packages, not npmjs.org.
# The Foxhole theme ships as @gavmor/foxhole-styles, published from gavmor/foxhole-styles.
@gavmor:registry=https://npm.pkg.github.com

# Auth token comes from the environment -- NEVER commit a real token here.
# Local dev:  export NODE_AUTH_TOKEN=$(gh auth token)   (needs the read:packages scope)
# CI:         NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}  with permissions: packages: read
# If NODE_AUTH_TOKEN is unset, npm substitutes nothing and the registry answers 401.
# See docs/github-packages.md
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
